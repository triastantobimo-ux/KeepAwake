<ui:FluentWindow x:Class="KeepAwake.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:KeepAwake.Services"
                 xmlns:vm="clr-namespace:KeepAwake.ViewModels"
                 Title="KeepAwake"
                 Width="1200" Height="840" MinWidth="1080" MinHeight="700"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource AppBackground}"
                 FontFamily="{StaticResource FontText}"
                 TextOptions.TextFormattingMode="Display"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="StateLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTitle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:LogRow}">
            <Grid Margin="14,5,14,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" Text="{Binding Clock}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource LogTextStyle}" Text="{Binding Text}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ChipLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="HeldChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayHeld}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeldValue" TargetType="TextBlock" BasedOn="{StaticResource ChipValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayHeld}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="KeepAwake" Height="40"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     Background="Transparent"
                     ButtonsBackground="Transparent"
                     ButtonsForeground="{DynamicResource TextSecondary}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontFamily="{StaticResource FontText}" FontSize="12" />

        <!-- ===== Menu row ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,2,14,4">
            <Button Style="{StaticResource MenuButton}" Click="OnNewSession"
                    Content="{Binding [Menu.NewSession], Source={x:Static svc:Loc.Instance}}" />

            <Button x:Name="ThemeButton" Style="{StaticResource MenuButton}" Click="OnThemeMenu"
                    Content="{Binding [Menu.Theme], Source={x:Static svc:Loc.Instance}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="ThemeLightItem" Click="OnThemeLight"
                                  Header="{Binding [Theme.Light], Source={x:Static svc:Loc.Instance}}" />
                        <MenuItem x:Name="ThemeDarkItem" Click="OnThemeDark"
                                  Header="{Binding [Theme.Dark], Source={x:Static svc:Loc.Instance}}" />
                        <MenuItem x:Name="ThemeSystemItem" Click="OnThemeSystem"
                                  Header="{Binding [Theme.System], Source={x:Static svc:Loc.Instance}}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button x:Name="LanguageButton" Style="{StaticResource MenuButton}" Click="OnLanguageMenu"
                    Content="{Binding [Menu.Language], Source={x:Static svc:Loc.Instance}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="LangEnItem" Click="OnLanguageEnglish"
                                  Header="{Binding [Lang.En], Source={x:Static svc:Loc.Instance}}" />
                        <MenuItem x:Name="LangIdItem" Click="OnLanguageIndonesian"
                                  Header="{Binding [Lang.Id], Source={x:Static svc:Loc.Instance}}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button Style="{StaticResource MenuButton}" Click="OnAbout"
                    Content="{Binding [Menu.About], Source={x:Static svc:Loc.Instance}}" />
            <Button Style="{StaticResource MenuButton}" Click="OnCloseApplication"
                    Content="{Binding [Menu.Close], Source={x:Static svc:Loc.Instance}}" />
        </StackPanel>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="2" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,16">
                <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource Accent}">
                    <ui:SymbolIcon Symbol="Power24" FontSize="22" Foreground="{DynamicResource OnAccent}" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayTitle}"
                               Text="{Binding [Header.Title], Source={x:Static svc:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                               Text="{Binding [Header.Subtitle], Source={x:Static svc:Loc.Instance}}" />
                </StackPanel>
            </StackPanel>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- Session status -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding [Status.Title], Source={x:Static svc:Loc.Instance}}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="48" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse x:Name="PulseOuter" Width="18" Height="18" Opacity="0"
                                                 Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PulseOuterScale" ScaleX="1" ScaleY="1" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="PulseInner" Width="18" Height="18" Opacity="0"
                                                 Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PulseInnerScale" ScaleX="1" ScaleY="1" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="PulseCore" Width="13" Height="13"
                                                 Fill="{DynamicResource TextMuted}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource StateLabelStyle}" Text="{Binding StateLabel}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                                   Text="{Binding StateHint}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,12,0,10" />

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricText}" Text="{Binding UptimeText}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,1,0,0"
                                                   Text="{Binding [Status.Uptime], Source={x:Static svc:Loc.Instance}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding StartedText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Guard settings -->
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding [Settings.Title], Source={x:Static svc:Loc.Instance}}" />

                                <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,6"
                                           Text="{Binding [Settings.Threshold], Source={x:Static svc:Loc.Instance}}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" TextAlignment="Left"
                                             Text="{Binding IntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap"
                                               Text="{Binding [Settings.Seconds], Source={x:Static svc:Loc.Instance}}" />
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,7,0,0"
                                           Text="{Binding [Settings.ThresholdHint], Source={x:Static svc:Loc.Instance}}" />

                                <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,12,0,12" />

                                <CheckBox IsChecked="{Binding SimulateInput, Mode=TwoWay}"
                                          Content="{Binding [Settings.Simulate], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="30,4,0,0"
                                           Text="{Binding [Settings.SimulateHint], Source={x:Static svc:Loc.Instance}}" />

                                <CheckBox Margin="0,12,0,0" IsEnabled="{Binding SimulateInput}"
                                          IsChecked="{Binding NudgeMouse, Mode=TwoWay}"
                                          Content="{Binding [Settings.Nudge], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="30,4,0,0"
                                           Text="{Binding [Settings.NudgeHint], Source={x:Static svc:Loc.Instance}}" />
                            </StackPanel>
                        </Border>

                        <!-- Session control -->
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding [Control.Title], Source={x:Static svc:Loc.Instance}}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                            IsEnabled="{Binding CanStart}" Click="OnStart"
                                            Content="{Binding [Control.Start], Source={x:Static svc:Loc.Instance}}" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                            IsEnabled="{Binding CanStop}" Click="OnRestart"
                                            Content="{Binding [Control.Restart], Source={x:Static svc:Loc.Instance}}" />
                                    <Button Grid.Column="4" Style="{StaticResource DangerButton}"
                                            IsEnabled="{Binding CanStop}" Click="OnStop"
                                            Content="{Binding [Control.Stop], Source={x:Static svc:Loc.Instance}}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,12,0,9" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ControlStatus}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Activity log -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,13,12,13">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                           Text="{Binding [Log.Title], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                           Text="{Binding EventCountText}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                                    Height="28" Padding="12,0" FontSize="12" Click="OnClearLog"
                                    Content="{Binding [Log.Clear], Source={x:Static svc:Loc.Instance}}" />
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource LogBackground}"
                                CornerRadius="0,0,8,8" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="0,1,0,0" ClipToBounds="True">
                            <Grid>
                                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="0,8,0,8">
                                    <ItemsControl ItemsSource="{Binding Log}" />
                                </ScrollViewer>
                                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="300" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding [Log.Empty], Source={x:Static svc:Loc.Instance}}">
                                    <TextBlock.Visibility>
                                        <Binding Path="HasLog">
                                            <Binding.Converter>
                                                <vm:InverseBoolToVisibility />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Protection bar -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Text="{Binding [Bar.Label], Source={x:Static svc:Loc.Instance}}" />

                        <Border Style="{StaticResource HeldChip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipLabel}"
                                           Text="{Binding [Bar.Display], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource HeldValue}" Text="{Binding DisplayState}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipLabel}"
                                           Text="{Binding [Bar.System], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Text="{Binding SystemState}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChipValue}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SystemHeld}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipLabel}"
                                           Text="{Binding [Bar.Power], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Text="{Binding PowerState}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChipValue}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PowerHeld}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipLabel}"
                                           Text="{Binding [Bar.Input], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource ChipValue}" Text="{Binding WakeSignals}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ChipLabel}"
                                           Text="{Binding [Bar.Idle], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource ChipValue}" FontFamily="{StaticResource FontMono}"
                                           Text="{Binding IdleNowText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>